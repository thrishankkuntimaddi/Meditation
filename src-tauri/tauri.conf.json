{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meditation",
  "version": "../package.json",
  "identifier": "com.thrishank.meditation",
  "build": {
    "frontendDist": "../dist-native",
    "beforeBuildCommand": "npm run build:native"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meditation",
        "width": 430,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "HealthcareAndFitness",
    "shortDescription": "Calm meditation and breathing",
    "copyright": "© Thrishank Kuntimaddi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
