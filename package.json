{
  "name": "meditation",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://thrishankkuntimaddi.github.io/Meditation/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm run build:native && electron .",
    "desktop:mac": "npm run build:native && electron-builder --mac",
    "desktop:win": "npm run build:native && electron-builder --win",
    "desktop:linux": "npm run build:native && electron-builder --linux",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "firebase": "^12.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "Calm, distraction-free meditation and breathing — web, Android and desktop, synced across devices.",
  "author": "Thrishank Kuntimaddi",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.thrishank.meditation",
    "productName": "Meditation",
    "copyright": "© Thrishank Kuntimaddi",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "dist-native/**/*",
      "!node_modules/**/*"
    ],
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "dmg": {
      "title": "Meditation"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Meditation"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "publish": null
  }
}
