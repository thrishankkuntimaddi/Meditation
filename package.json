    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.12.2",
